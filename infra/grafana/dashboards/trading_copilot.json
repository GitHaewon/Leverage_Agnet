{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "id": null,
  "uid": "trading-copilot-main",
  "title": "AI Trading Copilot — Production",
  "description": "Agent Health / Queue Health / Order Execution / Daily PnL / Drawdown / Error Rate",
  "tags": ["trading", "ai", "binance"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Order Success Rate (1h)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(trading_orders_total{status=\"filled\"}[1h])) / sum(rate(trading_orders_total[1h])) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Active Safety Halts",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(trading_safety_halt_active) or vector(0)",
          "legendFormat": "Active Halts",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Celery Queue Depth",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(trading_celery_queue_length) or vector(0)",
          "legendFormat": "Pending Tasks",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 200}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(trading_errors_total[5m])) or vector(0)",
          "legendFormat": "Errors/s",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Agent Health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Agent Pipeline — Run Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(trading_agent_runs_total{status=\"success\"}[5m])",
          "legendFormat": "{{agent}} success",
          "refId": "A"
        },
        {
          "expr": "rate(trading_agent_runs_total{status=\"failure\"}[5m])",
          "legendFormat": "{{agent}} failure",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Agent Pipeline — Latency p95 / p99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (agent, le) (rate(trading_agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (agent, le) (rate(trading_agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}} p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2, "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Queue Health (Celery)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Celery Task Rate by Status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (status) (rate(trading_celery_tasks_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "failure"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "retry"},
            "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "success"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Celery Queue Length",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "trading_celery_queue_length",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 20}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Order Execution",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "Order Rate — Success vs Failure",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (symbol, status) (rate(trading_orders_total[5m]))",
          "legendFormat": "{{symbol}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 32,
      "type": "timeseries",
      "title": "Order API Latency p50 / p95 / p99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (symbol, le) (rate(trading_order_latency_seconds_bucket[5m])))",
          "legendFormat": "{{symbol}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (symbol, le) (rate(trading_order_latency_seconds_bucket[5m])))",
          "legendFormat": "{{symbol}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (symbol, le) (rate(trading_order_latency_seconds_bucket[5m])))",
          "legendFormat": "{{symbol}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Daily PnL & Drawdown",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "Daily PnL (USDT) — by User",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "trading_daily_pnl_usdt",
          "legendFormat": "user:{{user_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {"lineWidth": 2, "fillOpacity": 5},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 100}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["last", "min", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 42,
      "type": "timeseries",
      "title": "Drawdown % from Peak",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "trading_drawdown_pct * 100",
          "legendFormat": "user:{{user_id}} drawdown",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 25,
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 20}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["last", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 50,
      "type": "row",
      "title": "Safety Halts",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41}
    },

    {
      "id": 51,
      "type": "timeseries",
      "title": "Safety Gate — Allowed vs Blocked",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 42},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(trading_safety_gate_checks_total[5m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "blocked"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "allowed"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 52,
      "type": "timeseries",
      "title": "Safety Gate Block — Reason Breakdown",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 42},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(trading_safety_gate_blocks_total[5m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 60,
      "type": "row",
      "title": "Error Rate & HTTP",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 48}
    },

    {
      "id": 61,
      "type": "timeseries",
      "title": "Error Rate by Component",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (component, error_type) (rate(trading_errors_total[5m]))",
          "legendFormat": "{{component}} / {{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom"}
      }
    },

    {
      "id": 62,
      "type": "timeseries",
      "title": "HTTP Request Rate & p95 Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (method, status) (rate(trading_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{status}} req/s",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(trading_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}} p95 latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 5}
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "unit", "value": "s"},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}
      }
    }

  ],

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource"
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Safety Halt",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "changes(trading_safety_halt_active[1m]) > 0",
        "step": "60s",
        "titleFormat": "Safety Halt",
        "textFormat": "scope={{scope}} reason={{reason}}"
      }
    ]
  }
}
