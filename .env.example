# ─────────────────────────────────────────────────────────────────────────────
# AI Trading Copilot — 환경변수 예시
# 실제 .env 파일을 이 파일에서 복사해 작성하라.
# .env 파일은 절대 git에 커밋하지 않는다.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://trading:trading_pass@localhost:5432/trading_copilot
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_pass
POSTGRES_DB=trading_copilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ── JWT (최소 32자 랜덤 문자열로 변경할 것) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_32_character_secret_key
JWT_REFRESH_SECRET=CHANGE_ME_minimum_32_character_refresh_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Binance (Testnet 기본 — 프로덕션 전환 시 false로 변경) ───────────────────
BINANCE_TESTNET=true
BINANCE_ENCRYPT_KEY=0123456789abcdef0123456789abcdef

# 실거래 전환: shadow 기간 충분히 검증 후 true로 변경 (docs/LIVE_TRADING_CHECKLIST.md)
LIVE_TRADING_ENABLED=false
SHADOW_TRADING_ENABLED=false
SHADOW_INITIAL_BALANCE_USDT=10000

# ── OpenAI (OPENAI_MODEL 환경변수로 모델 교체 — 기본 gpt-5) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trading-copilot.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
