# ─────────────────────────────────────────────────────────────────────────────
# AI Trading Copilot — 환경변수 예시
# 실제 .env 파일을 이 파일에서 복사해 작성하라.
# .env 파일은 절대 git에 커밋하지 않는다.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://trading:trading_pass@localhost:5432/trading_copilot
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_pass
POSTGRES_DB=trading_copilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ── JWT (최소 32자 랜덤 문자열로 변경할 것) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_32_character_secret_key
JWT_REFRESH_SECRET=CHANGE_ME_minimum_32_character_refresh_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Binance (Testnet 기본 — 프로덕션 전환 시 false로 변경) ───────────────────
BINANCE_TESTNET=true
BINANCE_ENCRYPT_KEY=0123456789abcdef0123456789abcdef

# 실거래 전환: shadow 기간 충분히 검증 후 true로 변경 (docs/LIVE_TRADING_CHECKLIST.md)
LIVE_TRADING_ENABLED=false
SHADOW_TRADING_ENABLED=false
SHADOW_INITIAL_BALANCE_USDT=10000
SHADOW_TAKER_FEE_RATE=0.0004
SHADOW_SLIPPAGE_BPS=5
SHADOW_FUNDING_RATE_PER_INTERVAL=0.0001
SHADOW_FUNDING_INTERVAL_HOURS=8

# Shadow-only A/B experiment. [ASSUMPTION] Defaults are intentionally disabled.
SHADOW_FAST_EXIT_V2_ENABLED=false
SHADOW_RISK_SIZING_V2_ENABLED=false
SHADOW_FAST_EXIT_MIN_SL_PCT=0.0025
SHADOW_FAST_EXIT_MAX_HOLD_SECONDS=900
SHADOW_FAST_EXIT_TP_PCT=0.006
SHADOW_FAST_EXIT_SL_PCT=0.003
SHADOW_FAST_EXIT_MIN_RR=2.0
SHADOW_RISK_PER_TRADE_PCT=0.01
SHADOW_SAFE_MAX_LEVERAGE=5
SHADOW_MIN_TP_COST_MULTIPLE=1.0
SHADOW_EXPERIMENT_LABEL=fast_exit_v2_ab
SHADOW_MAX_PORTFOLIO_RISK_PCT=0.10
SHADOW_MAX_SINGLE_MARGIN_RATIO=0.20
SHADOW_MARGIN_BUFFER_RATIO=1.10

# Shadow 전용 DecisionEngine 완화 프로파일 (값 미설정 시 live 기본값 사용)
# 설정 시 candidate_generator + strategy_selector 모두에 전파된다.
# LIVE_TRADING_ENABLED=true 이면 아래 설정은 무시된다.
SHADOW_MIN_LONG_SCORE=       # 기본 75.0 (예: 65 로 낮추면 후보 증가)
SHADOW_MIN_SHORT_SCORE=      # 기본 75.0
SHADOW_MAX_RISK_SCORE=       # 기본 55.0 (예: 60 으로 높이면 INTRADAY 포함)
SHADOW_AI_REVIEW_REQUIRED=true  # false = AI 리뷰 우회 (더 많은 체결 샘플)

# ── OpenAI (OPENAI_MODEL 환경변수로 모델 교체 — 기본 gpt-5) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trading-copilot.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
